# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Virtual environments & package managers
.pixi/
.venv/
env/
venv/
conda-env/

# Jupyter Notebook checkpoints & caches
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Pytest / coverage caches
.pytest_cache/
.coverage
htmlcov/

# Generated Reports (keep .gitkeep)
reports/*.html
reports/*.pdf
reports/*.ipynb

# Single-Cell Data & Large Artifacts (NFR-6 / FR-4)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.h5ad
*.loom
*.mtx
*.mtx.gz
*.bam
*.fastq.gz

# OS specific files
.DS_Store
Thumbs.db
